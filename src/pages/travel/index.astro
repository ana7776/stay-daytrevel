---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { byRecent } from '../../lib/categories.js';

const guides = (await getCollection('travel')).sort(byRecent);
---

<BaseLayout title="여행지 가이드 | Daytrevel Stay" description="계절별 여행지 동선과 방문 전 체크리스트 모음">
  <section class="page-head">
    <p class="eyebrow">Travel Guides</p>
    <h1>여행지 가이드</h1>
    <p>세부 키워드와 계절성을 기준으로 여행지 특징, 이동 동선, 방문 전 체크 포인트를 정리합니다.</p>
  </section>

  <section class="card-grid card-grid-page">
    {guides.map((guide) => (
      <ArticleCard entry={guide} basePath="/travel/" />
    ))}
  </section>
</BaseLayout>
