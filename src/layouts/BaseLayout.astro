---
import { getCollection } from 'astro:content';
import CategoryNav from '../components/CategoryNav.astro';
import { byRecent } from '../lib/categories.js';

const recommended = (await getCollection('travel')).sort(byRecent).slice(0, 3);

const {
  title = 'Daytrevel Stay',
  description = '여행자를 위한 숙박 큐레이션과 예약 가이드',
  image,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = []
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// image가 없는 글도 공유 시 썸네일이 나오도록 기본 이미지로 대체한다.
const usingDefaultImage = !image;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="naver-site-verification" content="a045e024a4aa350ba75d71974e0dc08b03013857" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/styles/global.css" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Daytrevel Stay" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* 크기는 실제 값을 아는 기본 이미지에만 선언한다. 외부 이미지는 크기가 제각각이라
        잘못된 값을 알리면 일부 플랫폼에서 렌더가 깨진다. */}
    {usingDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((graph) => <script type="application/ld+json" set:html={JSON.stringify(graph)} />)}

    {adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-top">
        <a class="brand" href="/">Daytrevel Stay</a>
        <nav aria-label="사이트 메뉴">
          <a href="https://daytrevel.com">Daytrevel</a>
        </nav>
      </div>
      <CategoryNav />
    </header>
    {adsenseClient && (
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot="6912286418"
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    )}
    {adsenseClient && (
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    )}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-columns">
        <div class="footer-brand">
          <p class="footer-logo">Daytrevel Stay</p>
          <p>여행 일정에 맞는 숙소와 여행지를 실용적인 기준으로 정리하는 여행 채널</p>
        </div>
        <div>
          <p class="footer-col-title">매거진</p>
          <a href="/">홈</a>
          <a href="/domestic/">국내여행</a>
          <a href="/overseas/">해외여행</a>
        </div>
        <div>
          <p class="footer-col-title">여행 허브</p>
          <a href="/travel/">여행지 가이드</a>
          <a href="/stays/">숙소 가이드</a>
        </div>
        <div>
          <p class="footer-col-title">카테고리</p>
          <a href="/domestic/">국내여행</a>
          <a href="/overseas/">해외여행</a>
          <a href="/stays/">숙소</a>
          <a href="/festival/">축제</a>
        </div>
        <div>
          <p class="footer-col-title">추천 읽을거리</p>
          {recommended.map((entry) => (
            <a href={`/travel/${entry.id}/`}>{entry.data.title}</a>
          ))}
        </div>
        <div>
          <p class="footer-col-title">LANGUAGE</p>
          <span class="footer-lang active">한국어</span>
          <a href="/en/">English</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Daytrevel Stay는 일부 링크에서 제휴 수수료를 받을 수 있습니다.</p>
        <nav aria-label="사이트 정보">
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/contact/">문의</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
