---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const spots = (await getCollection('spots')).sort((a, b) => a.data.title.localeCompare(b.data.title));

const title = '여행 정보 목록';
const description = '가볼만한 곳, 산책 코스 등 방문 전에 확인할 점을 정리한 여행 정보 모음';
const crumbs = [{ name: '홈', path: '/' }, { name: '여행 정보' }];

const jsonLd = [
	collectionPageJsonLd({
		name: title,
		description,
		path: '/spots/',
		items: spots.map((spot) => ({ title: spot.data.title, path: `/spots/${spot.id}/` })),
	}),
	breadcrumbJsonLd(crumbs),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<Breadcrumbs crumbs={crumbs} />
	<h1>여행 정보</h1>
	<ul class="stay-list">
		{
			spots.map((spot) => (
				<li>
					<a href={`/spots/${spot.id}/`}>{spot.data.title}</a>
					<p>{spot.data.description}</p>
				</li>
			))
		}
	</ul>
</Layout>
