---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const spots = await getCollection('spots');
	return spots.map((spot) => ({
		params: { slug: spot.id },
		props: { spot },
	}));
}

const { spot } = Astro.props;
const { title, description, keyword, heroImage, heroImageAlt, faq } = spot.data;
const ogImage = `/images/og/${spot.id}.jpg`;
const { Content } = await render(spot);

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.a,
		},
	})),
};
---

<Layout title={title} description={description} image={ogImage} type="article">
	<article class="stay-article">
		<img
			class="article-hero"
			src={heroImage}
			alt={heroImageAlt}
			width="1200"
			height="630"
			fetchpriority="high"
			decoding="async"
		/>

		<header>
			<h1>{title}</h1>
			<p class="stay-keyword">타겟 키워드: {keyword}</p>
		</header>

		<div class="stay-content">
			<Content />
		</div>

		<section class="faq" aria-labelledby="faq-heading">
			<h2 id="faq-heading">자주 묻는 질문</h2>
			<dl>
				{
					faq.map((item) => (
						<div class="faq-item">
							<dt>{item.q}</dt>
							<dd>{item.a}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</article>

	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
