---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const spots = await getCollection('spots');
	return spots.map((spot) => ({
		params: { slug: spot.id },
		props: { spot },
	}));
}

const { spot } = Astro.props;
const { title, description, keyword, faq, image } = spot.data;
const { Content } = await render(spot);

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.a,
		},
	})),
};
---

<Layout title={title} description={description}>
	<article class="stay-article">
		<header>
			<h1>{title}</h1>
			<p class="stay-keyword">타겟 키워드: {keyword}</p>
		</header>

		{
			image && (
				<figure class="stay-figure">
					<img src={image.url} alt={image.alt} loading="lazy" />
					<figcaption>
						{image.creditUrl ? <a href={image.creditUrl}>{image.credit}</a> : image.credit}
					</figcaption>
				</figure>
			)
		}

		<div class="stay-content">
			<Content />
		</div>

		<section class="faq" aria-labelledby="faq-heading">
			<h2 id="faq-heading">자주 묻는 질문</h2>
			<dl>
				{
					faq.map((item) => (
						<div class="faq-item">
							<dt>{item.q}</dt>
							<dd>{item.a}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</article>

	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
