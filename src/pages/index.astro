---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categoryOf, byRecent } from '../lib/categories.js';

const travelGuides = (await getCollection('travel')).sort(byRecent);
const stays = (await getCollection('stays')).sort(byRecent);

const all = [...travelGuides, ...stays].sort(byRecent);
const [featured, ...restOfTop] = all;
const heroGrid = restOfTop.slice(0, 4);
const featuredCategory = featured ? categoryOf(featured) : null;
const featuredHref = featured ? `/${featured.collection}/${featured.id}/` : '#';

const latestTravel = travelGuides.slice(0, 6);
const latestStays = stays.slice(0, 3);
---

<BaseLayout
  title="Daytrevel Stay | 여행 숙소 큐레이션"
  description="숙박 예약 전 확인해야 할 위치, 이동, 예산, 예약 조건을 정리하는 Daytrevel 숙소 전문 채널"
>
  <section class="hero">
    <div>
      <p class="eyebrow">stay.daytrevel.com</p>
      <h1>여행 일정에 맞는 숙소를 고르는 가장 실용적인 기준</h1>
      <p>
        호텔, 료칸, 리조트, 게스트하우스까지 동선과 예산 중심으로 비교합니다.
        예약 링크보다 먼저 확인해야 할 조건을 정리합니다.
      </p>
      <a class="button" href="/stays/">숙소 가이드 보기</a>
      <a class="button secondary" href="/travel/">여행지 가이드 보기</a>
    </div>
  </section>

  {featured && (
    <section class="section featured-section">
      <div class="featured-grid">
        <a class="featured-card" href={featuredHref}>
          {featured.data.image && (
            <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="eager" />
          )}
          <div class="featured-card-body">
            <span class="card-tag">{featuredCategory.label}</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
          </div>
        </a>
        <div class="featured-side-grid">
          {heroGrid.map((entry) => (
            <ArticleCard entry={entry} basePath={`/${entry.collection}/`} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>여행지 가이드</h2>
      <a class="more-link" href="/travel/">더보기</a>
    </div>
    <div class="card-grid">
      {latestTravel.map((entry) => (
        <ArticleCard entry={entry} basePath="/travel/" />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>숙소 가이드</h2>
      <a class="more-link" href="/stays/">더보기</a>
    </div>
    <div class="card-grid">
      {latestStays.map((entry) => (
        <ArticleCard entry={entry} basePath="/stays/" />
      ))}
    </div>
  </section>
</BaseLayout>
