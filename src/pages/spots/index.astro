---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const spots = (await getCollection('spots')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="여행 정보 목록" description="가볼만한 곳, 산책 코스 등 여행 정보 모음">
	<h1>여행 정보</h1>
	<ul class="card-list">
		{
			spots.map((spot) => (
				<li>
				<a href={`/spots/${spot.id}/`} class="card-link">
					<img
						class="card-thumb"
						src={spot.data.heroImage}
						alt={spot.data.heroImageAlt}
						width="1200"
						height="630"
						loading="lazy"
						decoding="async"
					/>
					<span class="card-title">{spot.data.title}</span>
				</a>
				<p>{spot.data.description}</p>
			</li>
			))
		}
	</ul>
</Layout>
