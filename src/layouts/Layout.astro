---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_LOCALE,
	DEFAULT_OG_IMAGE,
} from '../consts';

interface Props {
	title?: string;
	description?: string;
	/** 'website' for listing pages, 'article' for a single guide. */
	ogType?: 'website' | 'article';
	image?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
	/** JSON-LD graphs rendered into <head>. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	ogType = 'website',
	image = DEFAULT_OG_IMAGE,
	publishedTime,
	modifiedTime,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site).href}
		/>

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<link rel="stylesheet" href="/styles/global.css" />

		{jsonLd.map((graph) => <script type="application/ld+json" set:html={JSON.stringify(graph)} />)}
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
