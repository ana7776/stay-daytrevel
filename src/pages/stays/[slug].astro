---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const allSpots = await getCollection('spots');
const allStays = await getCollection('stays');

function resolve(collection: 'spots' | 'stays', ids: string[]) {
	const source = collection === 'spots' ? allSpots : allStays;
	return ids.map((id) => {
		const found = source.find((entry) => entry.id === id);
		if (!found) throw new Error(`연관글 슬러그를 찾을 수 없습니다: ${collection}/${id}`);
		return { href: `/${collection}/${found.id}/`, data: found.data };
	});
}

export async function getStaticPaths() {
	const stays = await getCollection('stays');
	return stays.map((stay) => ({
		params: { slug: stay.id },
		props: { stay },
	}));
}

const { stay } = Astro.props;
const { title, description, keyword, heroImage, heroImageAlt, faq } = stay.data;
const ogImage = `/images/og/${stay.id}.jpg`;
const related = [
	...resolve('spots', stay.data.relatedSpots),
	...resolve('stays', stay.data.relatedStays),
];
const { Content } = await render(stay);

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.a,
		},
	})),
};
---

<Layout title={title} description={description} image={ogImage} type="article">
	<article class="stay-article">
		<img
			class="article-hero"
			src={heroImage}
			alt={heroImageAlt}
			width="1200"
			height="630"
			fetchpriority="high"
			decoding="async"
		/>

		<header>
			<h1>{title}</h1>
			<p class="stay-keyword">타겟 키워드: {keyword}</p>
		</header>

		<div class="stay-content">
			<Content />
		</div>

		<section class="faq" aria-labelledby="faq-heading">
			<h2 id="faq-heading">자주 묻는 질문</h2>
			<dl>
				{
					faq.map((item) => (
						<div class="faq-item">
							<dt>{item.q}</dt>
							<dd>{item.a}</dd>
						</div>
					))
				}
			</dl>
		</section>

		{
			related.length > 0 && (
				<section class="related" aria-labelledby="related-heading">
					<h2 id="related-heading">함께 보면 좋은 글</h2>
					<ul class="card-list">
						{related.map((item) => (
							<li>
								<a href={item.href} class="card-link">
									<img
										class="card-thumb"
										src={item.data.heroImage}
										alt={item.data.heroImageAlt}
										width="1200"
										height="630"
										loading="lazy"
										decoding="async"
									/>
									<span class="card-title">{item.data.title}</span>
								</a>
								<p>{item.data.description}</p>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>

	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
