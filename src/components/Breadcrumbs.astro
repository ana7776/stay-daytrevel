---
const { crumbs, label = '현재 위치' } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {crumbs.map((crumb) => (
      <li>
        {crumb.path
          ? <a href={crumb.path}>{crumb.name}</a>
          : <span aria-current="page">{crumb.name}</span>}
      </li>
    ))}
  </ol>
</nav>
