---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../lib/seo.js';

export async function getStaticPaths() {
  const guides = await getCollection('travel');

  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const path = `/travel/${guide.id}/`;
const crumbs = [
  { name: '홈', path: '/' },
  { name: '여행지 가이드', path: '/travel/' },
  { name: guide.data.title }
];

const jsonLd = [
  articleJsonLd({ data: guide.data, path }),
  breadcrumbJsonLd(crumbs),
  ...(guide.data.faq.length ? [faqJsonLd(guide.data.faq)] : [])
];
---

<BaseLayout
  title={`${guide.data.title} | Daytrevel Stay`}
  description={guide.data.description}
  image={guide.data.image}
  ogType="article"
  publishedTime={guide.data.pubDate}
  modifiedTime={guide.data.updatedDate ?? guide.data.pubDate}
  jsonLd={jsonLd}
>
  <article class="article">
    <Breadcrumbs crumbs={crumbs} />
    <p class="meta">{[guide.data.country, guide.data.city, guide.data.season].filter(Boolean).join(' · ')}</p>
    <h1>{guide.data.title}</h1>
    <p class="lead">{guide.data.description}</p>
    {guide.data.image && (
      <figure class="article-image">
        <img src={guide.data.image} alt={guide.data.imageAlt ?? guide.data.title} loading="eager" />
        {(guide.data.imageCredit || guide.data.imageSource) && (
          <figcaption>
            {guide.data.imageCredit && <span>{guide.data.imageCredit}</span>}
            {guide.data.imageSource && (
              <a href={guide.data.imageSource} target="_blank" rel="noreferrer">이미지 출처</a>
            )}
          </figcaption>
        )}
      </figure>
    )}
    <Content />
    {guide.data.faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">자주 묻는 질문</h2>
        {guide.data.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
