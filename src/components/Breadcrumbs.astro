---
import type { Crumb } from '../lib/seo';

interface Props {
	crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="현재 위치">
	<ol>
		{
			crumbs.map((crumb) => (
				<li>
					{crumb.path ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
				</li>
			))
		}
	</ol>
</nav>
