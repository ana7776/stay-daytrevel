---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { byRecent, isFestival } from '../../lib/categories.js';

const guides = (await getCollection('travel')).filter(isFestival).sort(byRecent);
const crumbs = [{ name: '홈', path: '/' }, { name: '축제' }];
---

<BaseLayout title="축제 가이드 | Daytrevel Stay" description="국내외 축제 일정과 방문 전 체크리스트 모음">
  <section class="page-head">
    <Breadcrumbs crumbs={crumbs} />
    <p class="eyebrow">Festival</p>
    <h1>축제 가이드</h1>
    <p>시기별 축제 정보와 방문 전 체크 포인트를 정리합니다.</p>
  </section>

  <section class="card-grid card-grid-page">
    <h2 class="visually-hidden">축제 글 목록</h2>
    {guides.map((guide) => (
      <ArticleCard entry={guide} basePath="/travel/" />
    ))}
  </section>
</BaseLayout>
