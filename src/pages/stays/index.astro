---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const stays = (await getCollection('stays')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="숙소 가이드 목록" description="지역별 숙소 위치 선택 가이드 모음">
	<h1>숙소 가이드</h1>
	<ul class="stay-list">
		{
			stays.map((stay) => (
				<li>
					<a href={`/stays/${stay.id}/`}>{stay.data.title}</a>
					<p>{stay.data.description}</p>
				</li>
			))
		}
	</ul>
</Layout>
